---
type WorkoutStatus = "worked out" | "rest" | "skipped";

interface StatusDay {
  date: string;
  status: WorkoutStatus;
}

interface Props {
  startDate: string;
  endDate: string;
  days: StatusDay[];
}

const { startDate, endDate, days } = Astro.props;
const statuses = new Map(days.map(({ date, status }) => [date, status]));
const toDate = (date: string) => new Date(`${date}T00:00:00Z`);
const toIsoDate = (date: Date) => date.toISOString().slice(0, 10);
const monthFormatter = new Intl.DateTimeFormat("en-CA", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const dayFormatter = new Intl.DateTimeFormat("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const calendarDay = (date: Date) => {
  const isoDate = toIsoDate(date);
  return {
    date: isoDate,
    label: date.getUTCDate(),
    status: statuses.get(isoDate),
    accessibleDate: dayFormatter.format(date),
  };
};

const months = [];
if (startDate && endDate) {
  const cursor = toDate(startDate);
  cursor.setUTCDate(1);
  const finalMonth = toDate(endDate);
  finalMonth.setUTCDate(1);

  while (cursor <= finalMonth) {
    const year = cursor.getUTCFullYear();
    const month = cursor.getUTCMonth();
    const dayCount = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
    const leadingDayCount = cursor.getUTCDay();
    const leadingDays = Array.from({ length: leadingDayCount }, (_, index) =>
      calendarDay(new Date(Date.UTC(year, month, index - leadingDayCount + 1))),
    );
    const monthDays = Array.from({ length: dayCount }, (_, index) =>
      calendarDay(new Date(Date.UTC(year, month, index + 1))),
    );

    months.push({
      label: monthFormatter.format(cursor),
      days: [...leadingDays, ...monthDays],
    });
    cursor.setUTCMonth(cursor.getUTCMonth() + 1);
  }
}

const weekdays = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];
---

<section aria-labelledby="calendar-title">
  <header>
    <h2 id="calendar-title">workouts</h2>
    <p class="period">{months.at(-1)?.label}</p>
  </header>

  <div class="months">
    {
      months.map((month) => (
        <article>
          {months.length > 1 && month !== months.at(-1) && (
            <h3>{month.label}</h3>
          )}
          <div class="weekdays" aria-hidden="true">
            {weekdays.map((weekday) => (
              <span>{weekday.slice(0, 1)}</span>
            ))}
          </div>
          <div class="days">
            {month.days.map((day) => (
              <time
                class:list={[
                  "day",
                  day.status?.replace(" ", "-"),
                ]}
                datetime={day.date}
                title={day.status
                  ? `${day.accessibleDate}: ${day.status}`
                  : day.accessibleDate}
                aria-label={day.status
                  ? `${day.accessibleDate}: ${day.status}`
                  : `${day.accessibleDate}: not tracked`}
              >
                {day.label}
              </time>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <ul class="legend" aria-label="workout status legend">
    <li><span class="key worked-out"></span>worked out</li>
    <li><span class="key rest"></span>rest</li>
    <li><span class="key skipped"></span>skipped</li>
  </ul>
</section>

<style>
  section {
    position: relative;
    height: 100%;
    margin: 0;
    padding: 1rem;
    overflow: hidden;
    border: 2px solid #e5a8bf;
    border-radius: 1.5rem;
    background: rgba(255, 250, 253, 0.95);
    box-shadow: 0 7px 0 #edb8cb, 0 16px 32px rgba(112, 46, 74, 0.1);
  }

  section::after {
    position: absolute;
    right: -1.4rem;
    bottom: -1.9rem;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: #e5d8f2;
    content: "";
  }

  header {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  h2,
  h3,
  p {
    font-size: 1rem;
  }

  h2,
  h3 {
    color: #7f3554;
    font-family: "Iowan Old Style", "Palatino Linotype", Baskerville, Georgia,
      serif;
    font-style: italic;
  }

  h2 {
    font-size: 1.35rem;
  }

  .period {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid #e5a8bf;
    border-radius: 999px;
    color: #7f3554;
    background: #fbe4ec;
    font-size: 0.9rem;
    font-weight: 400;
  }

  .legend {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0;
    color: #7f3554;
    font-size: 0.8rem;
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .key {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid #b96c89;
    border-radius: 0.25rem;
  }

  .key.worked-out,
  .day.worked-out {
    color: #fff;
    background: #8b3f5e;
    border-color: #8b3f5e;
  }

  .key.rest,
  .day.rest {
    background: #e5d8f2;
  }

  .key.skipped,
  .day.skipped {
    border-style: dashed;
  }

  .months {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  article {
    min-width: 0;
  }

  h3 {
    margin-bottom: 0.75rem;
  }

  .weekdays,
  .days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.3rem;
  }

  .weekdays {
    margin-bottom: 0.3rem;
    color: #a35775;
    font-size: 0.75rem;
    text-align: center;
  }

  .day {
    min-height: 2rem;
  }

  .day {
    display: grid;
    place-items: center;
    min-width: 0;
    border: 1px solid #edd0dc;
    border-radius: 0.5rem;
    color: #c597aa;
    background: #fffafd;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .day.worked-out,
  .day.rest,
  .day.skipped {
    color: #572139;
    border-color: #b96c89;
  }

  .day.worked-out {
    color: #fff;
  }

</style>
