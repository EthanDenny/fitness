---
interface Point {
  date: string;
  value: number;
}

interface Props {
  title: string;
  dates: string[];
  actualPoints: Point[];
  averagePoints: Point[];
  unit: string;
  decimals?: number;
  target?: number;
}

const {
  title,
  dates,
  actualPoints,
  averagePoints,
  unit,
  decimals = 0,
  target,
} = Astro.props;
const width = 360;
const height = 210;
const padding = { top: 16, right: 12, bottom: 28, left: 48 };
const chartWidth = width - padding.left - padding.right;
const chartHeight = height - padding.top - padding.bottom;
const values = [
  ...actualPoints.map(({ value }) => value),
  ...averagePoints.map(({ value }) => value),
  ...(target === undefined ? [] : [target]),
];
const minimum = values.length ? Math.min(...values) : 0;
const maximum = values.length ? Math.max(...values) : 1;
const baseRange = maximum - minimum || Math.max(Math.abs(maximum) * 0.04, 1);
const targetRange =
  target === undefined
    ? undefined
    : Math.max(
        ...values.map((value) => Math.abs(value - target)),
        Math.max(Math.abs(target) * 0.04, 1),
      ) * 1.15;
const lowerBound =
  target === undefined ? minimum - baseRange * 0.15 : target - targetRange!;
const upperBound =
  target === undefined ? maximum + baseRange * 0.15 : target + targetRange!;
const valueRange = upperBound - lowerBound;
const dateIndexes = new Map(dates.map((date, index) => [date, index]));
const xPosition = (date: string) =>
  dates.length === 1
    ? padding.left + chartWidth / 2
    : padding.left +
      ((dateIndexes.get(date) ?? 0) / Math.max(dates.length - 1, 1)) * chartWidth;
const yPosition = (value: number) =>
  padding.top + ((upperBound - value) / valueRange) * chartHeight;
const segments = (points: Point[]) =>
  points.slice(1).map((point, index) => {
    const previous = points[index];
    return `M ${xPosition(previous.date).toFixed(2)} ${yPosition(previous.value).toFixed(2)} L ${xPosition(point.date).toFixed(2)} ${yPosition(point.value).toFixed(2)}`;
  });
const actualSegments = segments(actualPoints);
const averageSegments = segments(averagePoints);
const ticks = [
  upperBound,
  target ?? (upperBound + lowerBound) / 2,
  lowerBound,
];
const latestAverage = averagePoints.at(-1);
const formatValue = (value: number) =>
  value.toLocaleString("en-CA", {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  });
const formatDate = (date: string) => date.slice(5);
---

<figure>
  <figcaption>
    <span class="title">{title}</span>
    <strong>
      {latestAverage ? `${formatValue(latestAverage.value)} ${unit}` : "—"}
    </strong>
  </figcaption>

  {
    actualPoints.length ? (
      <svg
        viewBox={`0 0 ${width} ${height}`}
        role="img"
        aria-label={`${title} daily values and 7-day rolling average`}
      >
        {ticks.map((tick, index) => {
          const y = padding.top + (index / (ticks.length - 1)) * chartHeight;
          return (
            <g>
              <line
                x1={padding.left}
                x2={width - padding.right}
                y1={y}
                y2={y}
              />
              <text x={padding.left - 8} y={y + 4} text-anchor="end">
                {formatValue(tick)}
              </text>
            </g>
          );
        })}

        {actualSegments.map((path) => (
          <path class="actual" d={path} />
        ))}
        {averageSegments.map((path) => (
          <path class="average" d={path} />
        ))}

        <text x={padding.left} y={height - 5} text-anchor="start">
          {formatDate(dates[0])}
        </text>
        <text x={width - padding.right} y={height - 5} text-anchor="end">
          {formatDate(dates.at(-1)!)}
        </text>
      </svg>
    ) : (
      <p class="empty">no data</p>
    )
  }
</figure>

<style>
  figure {
    height: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.875rem;
    border: 1px solid #bbb;
  }

  figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1rem;
  }

  figcaption .title {
    font-weight: 700;
  }

  figcaption strong {
    font-weight: 400;
    white-space: nowrap;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 0.5rem;
    overflow: visible;
  }

  line {
    stroke: #ddd;
    stroke-width: 1;
  }

  path.actual,
  path.average {
    fill: none;
    stroke: #111;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  path.actual {
    stroke: #777;
    stroke-dasharray: 1 6;
    stroke-width: 1;
  }

  text {
    fill: #555;
    font-family: inherit;
    font-size: 0.75rem;
  }

  .empty {
    margin: 0;
    padding: 3rem 0;
    color: #555;
    text-align: center;
  }
</style>
