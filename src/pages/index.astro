---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import RollingAverageChart from "../components/RollingAverageChart.astro";
import WorkoutCalendar from "../components/WorkoutCalendar.astro";
import { rollingAverage } from "../lib/rolling-average.ts";
import { workoutStatus } from "../lib/workout-status.ts";

interface Nutrition {
  date: string;
  calories?: number;
  protein?: number;
  carbs?: number;
  fat?: number;
  fiber?: number;
  weight?: number;
  weightUnit?: string;
}

interface Workout {
  title: string;
  start_time: string;
  exercises?: unknown;
}

interface Day {
  date: string;
  nutrition?: Nutrition;
  workouts: Workout[];
}

type NutritionMetric = "calories" | "protein" | "weight";

const nutritionPath = resolve(process.cwd(), "data/cronometer/nutrition.csv");
const workoutsPath = resolve(process.cwd(), "data/hevy-workouts.json");
const currentDateParts = Object.fromEntries(
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/St_Johns",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  })
    .formatToParts(new Date())
    .map(({ type, value }) => [type, value]),
);
const today = `${currentDateParts.year}-${currentDateParts.month}-${currentDateParts.day}`;

const nutrition: Nutrition[] = existsSync(nutritionPath)
  ? readFileSync(nutritionPath, "utf8")
      .trim()
      .split(/\r?\n/)
      .slice(1)
      .filter(Boolean)
      .map((line) => {
        const [date, calories, protein, carbs, fat, fiber, weight, weightUnit] =
          line.split(",");
        return {
          date,
          calories: calories ? Number(calories) : undefined,
          protein: protein ? Number(protein) : undefined,
          carbs: carbs ? Number(carbs) : undefined,
          fat: fat ? Number(fat) : undefined,
          fiber: fiber ? Number(fiber) : undefined,
          weight: weight ? Number(weight) : undefined,
          weightUnit: weightUnit || undefined,
        };
      })
  : [];

let workouts: Workout[] = [];
if (existsSync(workoutsPath)) {
  const data: unknown = JSON.parse(readFileSync(workoutsPath, "utf8"));
  if (
    typeof data === "object" &&
    data !== null &&
    "workouts" in data &&
    Array.isArray(data.workouts)
  ) {
    workouts = data.workouts.filter(
      (workout): workout is Workout =>
        typeof workout === "object" &&
        workout !== null &&
        "title" in workout &&
        typeof workout.title === "string" &&
        "start_time" in workout &&
        typeof workout.start_time === "string",
    );
  }
}

const days = new Map<string, Day>();
for (const entry of nutrition) {
  days.set(entry.date, { date: entry.date, nutrition: entry, workouts: [] });
}
for (const workout of workouts) {
  const date = workout.start_time.slice(0, 10);
  const day = days.get(date) ?? { date, workouts: [] };
  day.workouts.push(workout);
  days.set(date, day);
}

const entries = [...days.values()].sort((a, b) => b.date.localeCompare(a.date));
const chronologicalDates = [...days.keys()].sort((a, b) => a.localeCompare(b));
const formatNumber = (value: number) =>
  Math.round(value).toLocaleString("en-CA");
const formatWeight = (value: number) =>
  value.toLocaleString("en-CA", {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });
const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null;
const liftedKilograms = (workout: Workout) => {
  if (!Array.isArray(workout.exercises)) return 0;

  return workout.exercises.reduce((exerciseTotal, exercise) => {
    if (!isRecord(exercise) || !Array.isArray(exercise.sets)) {
      return exerciseTotal;
    }

    return exerciseTotal + exercise.sets.reduce((setTotal, set) => {
      if (
        !isRecord(set) ||
        typeof set.weight_kg !== "number" ||
        !Number.isFinite(set.weight_kg) ||
        typeof set.reps !== "number" ||
        !Number.isFinite(set.reps)
      ) {
        return setTotal;
      }

      return setTotal + set.weight_kg * set.reps;
    }, 0);
  }, 0);
};
const formatLifted = (day: Day) => {
  if (day.workouts.length === 0) return "";

  const kilograms = day.workouts.reduce(
    (total, workout) => total + liftedKilograms(workout),
    0,
  );
  if (kilograms === 0) return "";

  const pounds = formatNumber(kilograms * 2.2046226218).padStart(6, "\u00a0");
  return `${pounds} lbs`;
};
const toDate = (date: string) => new Date(`${date}T00:00:00Z`);
const toIsoDate = (date: Date) => date.toISOString().slice(0, 10);
const dateRange = (start: string, end: string) => {
  const dates: string[] = [];
  const cursor = toDate(start);
  const finalDate = toDate(end);
  while (cursor <= finalDate) {
    dates.push(toIsoDate(cursor));
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }
  return dates;
};

const startDate = chronologicalDates[0] ?? "";
const endDate = chronologicalDates.at(-1) ?? "";
const trackedDates = startDate && endDate ? dateRange(startDate, endDate) : [];
const workoutDates = new Set(
  [...days.values()]
    .filter((day) => day.workouts.length > 0)
    .map((day) => day.date),
);
const statusForDate = (date: string) =>
  workoutStatus(date, today, workoutDates);
const workoutLabel = (day: Day) => {
  if (day.workouts.length > 0) {
    return day.workouts.map((workout) => workout.title).join(", ");
  }

  const status = statusForDate(day.date);
  return status === "pending"
    ? ""
    : status.charAt(0).toUpperCase() + status.slice(1);
};
const actualValues = (metric: NutritionMetric) =>
  nutrition.flatMap((entry) => {
    const value = entry[metric];
    return typeof value === "number" && Number.isFinite(value)
      ? [{ date: entry.date, value }]
      : [];
  });
const weightPoints = actualValues("weight");
const charts = [
  {
    title: "weight",
    dates: trackedDates,
    actualPoints: weightPoints,
    averagePoints: rollingAverage(trackedDates, weightPoints),
    unit: nutrition.findLast((entry) => entry.weightUnit)?.weightUnit ?? "",
    decimals: 1,
  },
  {
    title: "calories",
    dates: trackedDates,
    actualPoints: actualValues("calories"),
    averagePoints: rollingAverage(trackedDates, actualValues("calories")),
    unit: "kcal",
    decimals: 0,
    target: 1800,
  },
  {
    title: "protein",
    dates: trackedDates,
    actualPoints: actualValues("protein"),
    averagePoints: rollingAverage(trackedDates, actualValues("protein")),
    unit: "g",
    decimals: 0,
    target: 160,
  },
];
const workoutDays = trackedDates.map((date) => {
  return { date, status: statusForDate(date) };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Daily nutrition and workout history." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Fitness</title>
  </head>
  <body>
    <main>
      <header class="page-header">
        <h1>fitness</h1>
      </header>

      {
        entries.length > 0 ? (
          <>
            <div class="desktop-log">
              <table>
                <thead>
                  <tr>
                    <th class="column-date" scope="col">date</th>
                    <th class="column-weight" scope="col">weight</th>
                    <th class="column-calories" scope="col">calories</th>
                    <th class="column-workout" scope="col">workout</th>
                    <th class="column-lifted" scope="col">lifted</th>
                    <th class="column-protein" scope="col">protein</th>
                    <th class="column-carbs" scope="col">carbs</th>
                    <th class="column-fat" scope="col">fat</th>
                    <th class="column-fiber" scope="col">fiber</th>
                  </tr>
                </thead>
                <tbody>
                  {entries.map((day, index) => (
                    <tr
                      data-older-entry={index >= 7 ? "" : undefined}
                      hidden={index >= 7}
                    >
                      <td class="column-date">
                        <time datetime={day.date}>{day.date}</time>
                      </td>
                      <td class="column-weight">
                        {day.nutrition?.weight !== undefined &&
                        day.nutrition.weightUnit
                          ? `${formatWeight(day.nutrition.weight)} ${day.nutrition.weightUnit}`
                          : "—"}
                      </td>
                      <td class="column-calories">
                        {day.nutrition?.calories !== undefined
                          ? `${formatNumber(day.nutrition.calories)} kcal`
                          : "—"}
                      </td>
                      <td class="column-workout">{workoutLabel(day)}</td>
                      <td class="column-lifted">{formatLifted(day)}</td>
                      <td class="column-protein">
                        {day.nutrition?.protein !== undefined
                          ? `${formatNumber(day.nutrition.protein)} g`
                          : "—"}
                      </td>
                      <td class="column-carbs">
                        {day.nutrition?.carbs !== undefined
                          ? `${formatNumber(day.nutrition.carbs)} g`
                          : "—"}
                      </td>
                      <td class="column-fat">
                        {day.nutrition?.fat !== undefined
                          ? `${formatNumber(day.nutrition.fat)} g`
                          : "—"}
                      </td>
                      <td class="column-fiber">
                        {day.nutrition?.fiber !== undefined
                          ? `${formatNumber(day.nutrition.fiber)} g`
                          : "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="mobile-log">
              <div class="mobile-head" aria-hidden="true">
                <span>date</span>
                <span>weight</span>
                <span>calories</span>
                <span></span>
              </div>
              {entries.map((day, index) => (
                <details
                  data-older-entry={index >= 7 ? "" : undefined}
                  hidden={index >= 7}
                >
                  <summary>
                    <span>
                      <span class="visually-hidden">date </span>
                      <time datetime={day.date}>{day.date}</time>
                    </span>
                    <span>
                      <span class="visually-hidden">weight </span>
                      {day.nutrition?.weight !== undefined &&
                      day.nutrition.weightUnit
                        ? `${formatWeight(day.nutrition.weight)} ${day.nutrition.weightUnit}`
                        : "—"}
                    </span>
                    <span>
                      <span class="visually-hidden">calories </span>
                      {day.nutrition?.calories !== undefined
                        ? `${formatNumber(day.nutrition.calories)} kcal`
                        : "—"}
                    </span>
                    <span class="toggle" aria-hidden="true"></span>
                  </summary>
                  <dl>
                    <div>
                      <dt>workout</dt>
                      <dd>{workoutLabel(day)}</dd>
                    </div>
                    <div>
                      <dt>lifted</dt>
                      <dd>{formatLifted(day)}</dd>
                    </div>
                    <div>
                      <dt>protein</dt>
                      <dd>
                        {day.nutrition?.protein !== undefined
                          ? `${formatNumber(day.nutrition.protein)} g`
                          : "—"}
                      </dd>
                    </div>
                    <div>
                      <dt>carbs</dt>
                      <dd>
                        {day.nutrition?.carbs !== undefined
                          ? `${formatNumber(day.nutrition.carbs)} g`
                          : "—"}
                      </dd>
                    </div>
                    <div>
                      <dt>fat</dt>
                      <dd>
                        {day.nutrition?.fat !== undefined
                          ? `${formatNumber(day.nutrition.fat)} g`
                          : "—"}
                      </dd>
                    </div>
                    <div>
                      <dt>fiber</dt>
                      <dd>
                        {day.nutrition?.fiber !== undefined
                          ? `${formatNumber(day.nutrition.fiber)} g`
                          : "—"}
                      </dd>
                    </div>
                  </dl>
                </details>
              ))}
            </div>

            {entries.length > 7 && (
              <button
                class="history-toggle"
                type="button"
                data-history-toggle
                aria-expanded="false"
              >
                show all
              </button>
            )}

            <section class="dashboard-grid" aria-label="fitness trends">
              {charts.map((chart) => (
                <RollingAverageChart {...chart} />
              ))}
              <WorkoutCalendar
                startDate={startDate}
                endDate={endDate}
                days={workoutDays}
              />
            </section>
          </>
        ) : (
          <p class="empty">
            No fitness data yet. Run <code>npm run pull</code>.
          </p>
        )
      }
    </main>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-history-toggle]",
      );
      const olderEntries = document.querySelectorAll<HTMLElement>(
        "[data-older-entry]",
      );

      toggle?.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";

        olderEntries.forEach((entry) => {
          entry.hidden = isExpanded;
        });
        toggle.setAttribute("aria-expanded", String(!isExpanded));
        toggle.textContent = isExpanded ? "show all" : "show last 7 days";
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family: ui-monospace, "SFMono-Regular", "Cascadia Code", "Roboto Mono",
      Consolas, monospace;
    color: #111;
    background: #fff;
    text-transform: lowercase;
  }

  :global(body) {
    margin: 0;
  }

  main {
    width: min(100% - 2rem, 54rem);
    margin: 0 auto;
    padding: 4rem 0;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }

  h1,
  p,
  table {
    margin: 0;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    letter-spacing: -0.06em;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .page-header p {
    color: #555;
    font-size: 0.875rem;
  }

  .desktop-log {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .mobile-log {
    display: none;
  }

  .history-toggle {
    display: block;
    margin: 0.75rem 0 0;
    padding: 0;
    border: 0;
    color: #111;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
  }

  .history-toggle:hover,
  .history-toggle:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .history-toggle:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }

  table {
    width: max-content;
    min-width: 100%;
    max-width: none;
    border-collapse: collapse;
    white-space: nowrap;
  }

  th,
  td {
    padding: 0.75rem 0.5rem;
    text-align: left;
  }

  th {
    color: #111;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: normal;
    text-transform: lowercase;
  }

  thead {
    border-bottom: 1px solid #bbb;
  }

  tbody tr {
    border-bottom: 1px solid #bbb;
  }

  td {
    overflow: hidden;
    font-size: 1rem;
    text-overflow: ellipsis;
  }

  td.column-protein,
  td.column-carbs,
  td.column-fat,
  td.column-fiber {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .empty {
    padding: 2rem 0;
    line-height: 1.6;
  }

  code {
    padding: 0.1rem 0.25rem;
    border: 1px solid #bbb;
  }

  @media (max-width: 48rem) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .desktop-log {
      display: none;
    }

    .mobile-log {
      display: block;
    }

    .mobile-head,
    summary {
      display: grid;
      grid-template-columns:
        minmax(10ch, 1.3fr) minmax(9ch, 1fr) minmax(10ch, 1.2fr) auto;
      align-items: center;
      gap: clamp(0.5rem, 2.5vw, 1.25rem);
      padding: 0.875rem 0.5rem;
      font-size: 0.875rem;
    }

    .mobile-head {
      border-bottom: 1px solid #bbb;
      font-weight: 700;
    }

    details {
      border-bottom: 1px solid #bbb;
    }

    summary {
      cursor: pointer;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary:focus-visible {
      outline: 2px solid #111;
      outline-offset: -2px;
    }

    .toggle {
      justify-self: end;
      font-size: 1rem;
      line-height: 1;
    }

    .toggle::before {
      content: "+";
    }

    details[open] .toggle::before {
      content: "−";
    }

    dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.875rem 1rem;
      margin: 0;
      padding: 0.375rem 0.5rem 1rem;
      font-size: 0.875rem;
    }

    dl div {
      min-width: 0;
      padding-left: 0.5rem;
      border-left: 1px solid #bbb;
    }

    dt {
      font-weight: 700;
    }

    dd {
      margin: 0.2rem 0 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (max-width: 36rem) {
    main {
      width: calc(100% - 1rem);
      padding-top: 2rem;
    }
  }

</style>
