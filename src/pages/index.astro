---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import StickerCanvas from "../components/StickerCanvas.astro";
import RollingAverageChart from "../components/RollingAverageChart.astro";
import WorkoutCalendar from "../components/WorkoutCalendar.astro";

interface Nutrition {
  date: string;
  calories?: number;
  protein?: number;
  carbs?: number;
  fat?: number;
  fiber?: number;
  weight?: number;
  weightUnit?: string;
}

interface Workout {
  title: string;
  start_time: string;
  exercises?: unknown;
}

interface Day {
  date: string;
  nutrition?: Nutrition;
  workouts: Workout[];
}

type NutritionMetric = "calories" | "protein" | "weight";
type WorkoutStatus = "worked out" | "rest" | "skipped";

const nutritionPath = resolve(process.cwd(), "data/cronometer/nutrition.csv");
const workoutsPath = resolve(process.cwd(), "data/hevy-workouts.json");

const nutrition: Nutrition[] = existsSync(nutritionPath)
  ? readFileSync(nutritionPath, "utf8")
      .trim()
      .split(/\r?\n/)
      .slice(1)
      .filter(Boolean)
      .map((line) => {
        const [date, calories, protein, carbs, fat, fiber, weight, weightUnit] =
          line.split(",");
        return {
          date,
          calories: calories ? Number(calories) : undefined,
          protein: protein ? Number(protein) : undefined,
          carbs: carbs ? Number(carbs) : undefined,
          fat: fat ? Number(fat) : undefined,
          fiber: fiber ? Number(fiber) : undefined,
          weight: weight ? Number(weight) : undefined,
          weightUnit: weightUnit || undefined,
        };
      })
  : [];

let workouts: Workout[] = [];
if (existsSync(workoutsPath)) {
  const data: unknown = JSON.parse(readFileSync(workoutsPath, "utf8"));
  if (
    typeof data === "object" &&
    data !== null &&
    "workouts" in data &&
    Array.isArray(data.workouts)
  ) {
    workouts = data.workouts.filter(
      (workout): workout is Workout =>
        typeof workout === "object" &&
        workout !== null &&
        "title" in workout &&
        typeof workout.title === "string" &&
        "start_time" in workout &&
        typeof workout.start_time === "string",
    );
  }
}

const days = new Map<string, Day>();
for (const entry of nutrition) {
  days.set(entry.date, { date: entry.date, nutrition: entry, workouts: [] });
}
for (const workout of workouts) {
  const date = workout.start_time.slice(0, 10);
  const day = days.get(date) ?? { date, workouts: [] };
  day.workouts.push(workout);
  days.set(date, day);
}

const entries = [...days.values()].sort((a, b) => b.date.localeCompare(a.date));
const chronologicalDates = [...days.keys()].sort((a, b) => a.localeCompare(b));
const formatNumber = (value: number) =>
  Math.round(value).toLocaleString("en-CA");
const formatWeight = (value: number) =>
  value.toLocaleString("en-CA", {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });
const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null;
const liftedKilograms = (workout: Workout) => {
  if (!Array.isArray(workout.exercises)) return 0;

  return workout.exercises.reduce((exerciseTotal, exercise) => {
    if (!isRecord(exercise) || !Array.isArray(exercise.sets)) {
      return exerciseTotal;
    }

    return exerciseTotal + exercise.sets.reduce((setTotal, set) => {
      if (
        !isRecord(set) ||
        typeof set.weight_kg !== "number" ||
        !Number.isFinite(set.weight_kg) ||
        typeof set.reps !== "number" ||
        !Number.isFinite(set.reps)
      ) {
        return setTotal;
      }

      return setTotal + set.weight_kg * set.reps;
    }, 0);
  }, 0);
};
const formatLifted = (day: Day) => {
  if (day.workouts.length === 0) return "";

  const kilograms = day.workouts.reduce(
    (total, workout) => total + liftedKilograms(workout),
    0,
  );
  if (kilograms === 0) return "";

  const pounds = formatNumber(kilograms * 2.2046226218).padStart(6, "\u00a0");
  return `${pounds} lbs`;
};
const previousDate = (date: string) => {
  const value = new Date(`${date}T00:00:00Z`);
  value.setUTCDate(value.getUTCDate() - 1);
  return value.toISOString().slice(0, 10);
};
const workoutLabel = (day: Day) => {
  if (day.workouts.length > 0) {
    return day.workouts.map((workout) => workout.title).join(", ");
  }

  return days.get(previousDate(day.date))?.workouts.length ? "Rest" : "Skipped";
};

const toDate = (date: string) => new Date(`${date}T00:00:00Z`);
const toIsoDate = (date: Date) => date.toISOString().slice(0, 10);
const dateRange = (start: string, end: string) => {
  const dates: string[] = [];
  const cursor = toDate(start);
  const finalDate = toDate(end);
  while (cursor <= finalDate) {
    dates.push(toIsoDate(cursor));
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }
  return dates;
};

const startDate = chronologicalDates[0] ?? "";
const endDate = chronologicalDates.at(-1) ?? "";
const trackedDates = startDate && endDate ? dateRange(startDate, endDate) : [];
const actualValues = (metric: NutritionMetric) =>
  nutrition.flatMap((entry) => {
    const value = entry[metric];
    return typeof value === "number" && Number.isFinite(value)
      ? [{ date: entry.date, value }]
      : [];
  });
const rollingAverage = (metric: NutritionMetric) =>
  trackedDates.flatMap((date) => {
    const windowStart = toDate(date);
    windowStart.setUTCDate(windowStart.getUTCDate() - 6);
    const start = toIsoDate(windowStart);
    const values = nutrition
      .filter((entry) => entry.date >= start && entry.date <= date)
      .map((entry) => entry[metric])
      .filter((value): value is number =>
        typeof value === "number" && Number.isFinite(value),
      );

    return values.length === 7
      ? [{
          date,
          value: values.reduce((sum, value) => sum + value, 0) / values.length,
        }]
      : [];
  });
const charts = [
  {
    title: "weight",
    dates: trackedDates,
    actualPoints: actualValues("weight"),
    averagePoints: rollingAverage("weight"),
    unit: nutrition.findLast((entry) => entry.weightUnit)?.weightUnit ?? "",
    decimals: 1,
  },
  {
    title: "calories",
    dates: trackedDates,
    actualPoints: actualValues("calories"),
    averagePoints: rollingAverage("calories"),
    unit: "kcal",
    decimals: 0,
    target: 2000,
  },
  {
    title: "protein",
    dates: trackedDates,
    actualPoints: actualValues("protein"),
    averagePoints: rollingAverage("protein"),
    unit: "g",
    decimals: 0,
    target: 150,
  },
];
const workoutDays = trackedDates.map((date) => {
  const status: WorkoutStatus = days.get(date)?.workouts.length
    ? "worked out"
    : days.get(previousDate(date))?.workouts.length
      ? "rest"
      : "skipped";
  return { date, status };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Daily nutrition and workout history." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Fitness</title>
  </head>
  <body>
    <StickerCanvas />
    <main>
      <header class="page-header">
        <h1>fitness</h1>
      </header>

      {
        entries.length > 0 ? (
          <>
            <section class="log-card" aria-label="fitness log">
              <div class="desktop-log">
                <table>
                  <thead>
                    <tr>
                      <th class="column-date" scope="col">date</th>
                      <th class="column-weight" scope="col">weight</th>
                      <th class="column-calories" scope="col">calories</th>
                      <th class="column-workout" scope="col">workout</th>
                      <th class="column-lifted" scope="col">lifted</th>
                      <th class="column-protein" scope="col">protein</th>
                      <th class="column-carbs" scope="col">carbs</th>
                      <th class="column-fat" scope="col">fat</th>
                      <th class="column-fiber" scope="col">fiber</th>
                    </tr>
                  </thead>
                  <tbody>
                    {entries.map((day, index) => (
                      <tr
                        data-older-entry={index >= 7 ? "" : undefined}
                        hidden={index >= 7}
                      >
                        <td class="column-date">
                          <time datetime={day.date}>{day.date}</time>
                        </td>
                        <td class="column-weight">
                          {day.nutrition?.weight !== undefined &&
                          day.nutrition.weightUnit
                            ? `${formatWeight(day.nutrition.weight)} ${day.nutrition.weightUnit}`
                            : "—"}
                        </td>
                        <td class="column-calories">
                          {day.nutrition?.calories !== undefined
                            ? `${formatNumber(day.nutrition.calories)} kcal`
                            : "—"}
                        </td>
                        <td class="column-workout">{workoutLabel(day)}</td>
                        <td class="column-lifted">{formatLifted(day)}</td>
                        <td class="column-protein">
                          {day.nutrition?.protein !== undefined
                            ? `${formatNumber(day.nutrition.protein)} g`
                            : "—"}
                        </td>
                        <td class="column-carbs">
                          {day.nutrition?.carbs !== undefined
                            ? `${formatNumber(day.nutrition.carbs)} g`
                            : "—"}
                        </td>
                        <td class="column-fat">
                          {day.nutrition?.fat !== undefined
                            ? `${formatNumber(day.nutrition.fat)} g`
                            : "—"}
                        </td>
                        <td class="column-fiber">
                          {day.nutrition?.fiber !== undefined
                            ? `${formatNumber(day.nutrition.fiber)} g`
                            : "—"}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div class="mobile-log">
                <div class="mobile-head" aria-hidden="true">
                  <span>date</span>
                  <span>weight</span>
                  <span>calories</span>
                  <span></span>
                </div>
                {entries.map((day, index) => (
                  <details
                    data-older-entry={index >= 7 ? "" : undefined}
                    hidden={index >= 7}
                  >
                    <summary>
                      <span>
                        <span class="visually-hidden">date </span>
                        <time datetime={day.date}>{day.date}</time>
                      </span>
                      <span>
                        <span class="visually-hidden">weight </span>
                        {day.nutrition?.weight !== undefined &&
                        day.nutrition.weightUnit
                          ? `${formatWeight(day.nutrition.weight)} ${day.nutrition.weightUnit}`
                          : "—"}
                      </span>
                      <span>
                        <span class="visually-hidden">calories </span>
                        {day.nutrition?.calories !== undefined
                          ? `${formatNumber(day.nutrition.calories)} kcal`
                          : "—"}
                      </span>
                      <span class="toggle" aria-hidden="true"></span>
                    </summary>
                    <dl>
                      <div>
                        <dt>workout</dt>
                        <dd>{workoutLabel(day)}</dd>
                      </div>
                      <div>
                        <dt>lifted</dt>
                        <dd>{formatLifted(day)}</dd>
                      </div>
                      <div>
                        <dt>protein</dt>
                        <dd>
                          {day.nutrition?.protein !== undefined
                            ? `${formatNumber(day.nutrition.protein)} g`
                            : "—"}
                        </dd>
                      </div>
                      <div>
                        <dt>carbs</dt>
                        <dd>
                          {day.nutrition?.carbs !== undefined
                            ? `${formatNumber(day.nutrition.carbs)} g`
                            : "—"}
                        </dd>
                      </div>
                      <div>
                        <dt>fat</dt>
                        <dd>
                          {day.nutrition?.fat !== undefined
                            ? `${formatNumber(day.nutrition.fat)} g`
                            : "—"}
                        </dd>
                      </div>
                      <div>
                        <dt>fiber</dt>
                        <dd>
                          {day.nutrition?.fiber !== undefined
                            ? `${formatNumber(day.nutrition.fiber)} g`
                            : "—"}
                        </dd>
                      </div>
                    </dl>
                  </details>
                ))}
              </div>

              {entries.length > 7 && (
                <button
                  class="history-toggle"
                  type="button"
                  data-history-toggle
                  aria-expanded="false"
                >
                  show all
                </button>
              )}
            </section>

            <section class="dashboard-grid" aria-label="fitness trends">
              {charts.map((chart) => (
                <RollingAverageChart {...chart} />
              ))}
              <WorkoutCalendar
                startDate={startDate}
                endDate={endDate}
                days={workoutDays}
              />
            </section>
          </>
        ) : (
          <p class="empty">
            No fitness data yet. Run <code>npm run pull</code>.
          </p>
        )
      }
    </main>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-history-toggle]",
      );
      const olderEntries = document.querySelectorAll<HTMLElement>(
        "[data-older-entry]",
      );

      toggle?.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";

        olderEntries.forEach((entry) => {
          entry.hidden = isExpanded;
        });
        toggle.setAttribute("aria-expanded", String(!isExpanded));
        toggle.textContent = isExpanded ? "show all" : "show last 7 days";
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    --berry: #7f3554;
    --berry-dark: #572139;
    --rose: #d9789f;
    --rose-soft: #f3bfd2;
    --blush: #fbe4ec;
    --cream: #fffafd;
    --lavender: #e5d8f2;
    --gold: #e8b852;
    --line: #e5a8bf;
    --shadow: #edb8cb;
  }

  :global(html) {
    color: var(--berry-dark);
    background-color: #fcedf3;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.52) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.52) 1px, transparent 1px),
      radial-gradient(circle at 50% 0%, #fff9fc 0, transparent 48rem);
    background-size: 34px 34px, 34px 34px, auto;
    font-family: ui-monospace, "SFMono-Regular", "Cascadia Code", "Roboto Mono",
      Consolas, monospace;
    text-transform: lowercase;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
  }

  :global(::selection) {
    color: var(--berry-dark);
    background: var(--rose-soft);
  }

  main {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 64rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .page-header {
    display: grid;
    place-items: center;
    padding: 2.5rem 1rem 3rem;
    text-align: center;
  }

  h1,
  p,
  table {
    margin: 0;
  }

  h1 {
    font-family: "Iowan Old Style", "Palatino Linotype", Baskerville, Georgia,
      serif;
  }

  h1 {
    color: var(--berry);
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.9;
    text-shadow: 0 4px 0 #fff, 0 7px 0 var(--rose-soft);
  }

  .log-card {
    position: relative;
    padding: 1.2rem;
    border: 2px solid var(--line);
    border-radius: 2rem;
    background: rgba(255, 250, 253, 0.94);
    box-shadow: 0 9px 0 var(--shadow), 0 24px 50px rgba(112, 46, 74, 0.13);
  }

  .log-card::before {
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 7rem;
    height: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: repeating-linear-gradient(
      135deg,
      #f5bfd2 0 8px,
      #fff8fb 8px 16px
    );
    content: "";
    transform: translateX(-50%) rotate(-1.5deg);
  }

  .desktop-log {
    width: 100%;
    overflow-x: auto;
    border: 1px solid #ebbed0;
    border-radius: 1.2rem;
    background: var(--cream);
    overscroll-behavior-inline: contain;
  }

  .mobile-log {
    display: none;
  }

  table {
    width: max-content;
    min-width: 100%;
    max-width: none;
    border-collapse: collapse;
    white-space: nowrap;
  }

  th,
  td {
    padding: 0.85rem 0.58rem;
    text-align: left;
  }

  th {
    color: var(--berry);
    background: #f9dce7;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.015em;
  }

  thead {
    border-bottom: 1px solid #e8aec4;
  }

  tbody tr {
    border-bottom: 1px solid #efd0dc;
  }

  tbody tr:last-child {
    border-bottom: 0;
  }

  tbody tr:nth-child(even) {
    background: #fff4f8;
  }

  tbody tr:hover {
    background: #fbe7ef;
  }

  td {
    overflow: hidden;
    color: #623147;
    font-size: 0.87rem;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
  }

  td.column-protein,
  td.column-carbs,
  td.column-fat,
  td.column-fiber {
    text-align: right;
  }

  .history-toggle {
    display: block;
    margin: 1rem 0.5rem 0;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--berry);
    background: var(--blush);
    box-shadow: 0 3px 0 var(--rose-soft);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }

  .history-toggle:hover {
    background: #f6cedd;
    transform: translateY(-1px);
  }

  .history-toggle:active {
    box-shadow: 0 1px 0 var(--rose-soft);
    transform: translateY(2px);
  }

  .history-toggle:focus-visible,
  summary:focus-visible {
    outline: 3px solid #bf668a;
    outline-offset: 3px;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 4rem;
  }

  .empty {
    padding: 2rem;
    border: 2px solid var(--line);
    border-radius: 2rem;
    background: var(--cream);
    line-height: 1.6;
    text-align: center;
  }

  code {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: var(--blush);
  }

  @media (max-width: 48rem) {
    main {
      width: min(100% - 1rem, 38rem);
      padding-top: 2rem;
    }

    .page-header {
      padding: 2.5rem 0.5rem 2.75rem;
    }

    .log-card {
      padding: 0.65rem;
      border-radius: 1.5rem;
    }

    .dashboard-grid {
      grid-template-columns: 1fr;
      margin-top: 3rem;
    }

    .desktop-log {
      display: none;
    }

    .mobile-log {
      display: block;
      overflow: hidden;
      border: 1px solid #ebbed0;
      border-radius: 1rem;
      background: var(--cream);
    }

    .mobile-head,
    summary {
      display: grid;
      grid-template-columns:
        minmax(9.5ch, 1.3fr) minmax(8ch, 1fr) minmax(9ch, 1.2fr) auto;
      align-items: center;
      gap: clamp(0.35rem, 2vw, 0.8rem);
      padding: 0.9rem 0.65rem;
      font-size: clamp(0.68rem, 2.6vw, 0.82rem);
    }

    .mobile-head {
      color: var(--berry);
      background: #f9dce7;
      font-weight: 700;
    }

    details {
      border-top: 1px solid #efd0dc;
    }

    details[open] {
      background: #fff5f8;
    }

    summary {
      cursor: pointer;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    .toggle {
      display: grid;
      place-items: center;
      justify-self: end;
      width: 1.35rem;
      height: 1.35rem;
      border: 1px solid var(--line);
      border-radius: 50%;
      color: var(--berry);
      background: var(--blush);
      font-size: 0.95rem;
      line-height: 1;
    }

    .toggle::before {
      content: "+";
    }

    details[open] .toggle::before {
      content: "−";
    }

    dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
      margin: 0;
      padding: 0.25rem 0.65rem 1rem;
      font-size: 0.78rem;
    }

    dl div {
      min-width: 0;
      padding: 0.65rem;
      border: 1px solid #efd0dc;
      border-radius: 0.75rem;
      background: rgba(255, 255, 255, 0.65);
    }

    dt {
      color: #a34f72;
      font-weight: 700;
    }

    dd {
      margin: 0.25rem 0 0;
      font-variant-numeric: tabular-nums;
    }

    .history-toggle {
      margin: 0.85rem 0.65rem 0.35rem;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (max-width: 28rem) {
    .mobile-head,
    summary {
      grid-template-columns: 9.4ch 8.3ch minmax(8.5ch, 1fr) auto;
      padding-inline: 0.45rem;
    }

  }
</style>
